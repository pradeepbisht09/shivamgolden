@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700;800&display=swap');

:root{--gold:#ffc52f;--gold2:#f2a900;--black:#080a0b;--ink:#141618;--muted:#62666a;--line:#dedede}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,Arial,sans-serif;color:var(--ink);background:#fff}a{text-decoration:none;color:inherit}.topbar{height:29px;background:#0c0f10;color:#e7e7e7;display:flex;align-items:center;justify-content:space-between;padding:0 5.5%;font-size:12px;border-bottom:1px solid #272a2c}.topbar span:first-child{color:#fff}.header{height:86px;background:#090b0c;display:flex;align-items:center;padding:0 5.5%;gap:32px;color:#fff;position:sticky;top:0;z-index:20;border-bottom:1px solid #191b1c}.brand{width:355px;display:flex;align-items:center}.brand img{width:310px;height:78px;object-fit:cover;object-position:center;border-radius:4px}.nav{display:flex;align-items:center;gap:40px;margin-left:auto}.nav a{font-size:15px;font-weight:600;padding:31px 0;position:relative;white-space:nowrap}.nav a.active,.nav a:hover{color:var(--gold)}.nav a.active:after{content:"";position:absolute;left:0;right:0;bottom:19px;height:3px;background:var(--gold)}.btn{border:0;border-radius:9px;padding:14px 24px;font-weight:800;font-size:15px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;transition:.2s transform,.2s box-shadow}.btn:hover{transform:translateY(-2px);box-shadow:0 8px 22px #0002}.btn-yellow{background:var(--gold);color:#080808}.btn-outline{border:1px solid #fff;background:#0b0c0d;color:#fff}.nav-cta{margin-left:10px;min-width:164px}.menu-toggle{display:none;background:none;border:0;color:#fff;font-size:27px}.hero{min-height:455px;background:#080a0b;display:grid;grid-template-columns:47% 53%;overflow:hidden}.hero-copy{padding:34px 6% 26px 5.5%;color:#fff;background:radial-gradient(circle at 70% 10%,#242b2e 0,#0b0d0e 48%,#030405 100%);position:relative;z-index:2}.eyebrow{font-size:12px;letter-spacing:5px;font-weight:700;color:#eee;margin:0 0 10px}.eyebrow i{display:inline-block;width:4px;height:4px;border-radius:50%;background:var(--gold);margin:0 9px 2px}.hero h1{font-family:'Barlow Condensed',sans-serif;font-size:56px;line-height:.95;margin:0 0 8px;font-weight:800;letter-spacing:.3px}.hero h1 span,.section-head span,.contact .section-head span{color:var(--gold)}.hero h2{font-size:20px;margin:0 0 10px}.hero-copy>p{font-size:16px;line-height:1.5;max-width:610px;margin:0 0 12px}.hero-actions{display:flex;gap:14px;margin-bottom:15px}.hero-actions .btn-yellow{min-width:282px}.trust-row{display:flex;gap:22px}.trust-row div{display:flex;gap:9px;align-items:center;font-size:11px;line-height:1.25}.trust-row b{width:38px;height:38px;border:3px solid var(--gold);border-radius:50%;display:grid;place-items:center;color:var(--gold);font-size:19px}.hero-visual{position:relative;background:#15191a url('assets/hero-truck.jpg') center/cover no-repeat;min-height:455px}.hero-visual:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#0a0b0c 0%,transparent 25%,transparent 68%,#0a0b0caa 100%)}.quote{position:absolute;right:7%;top:20px;color:#fff;font-family:'Barlow Condensed',sans-serif;font-size:20px;line-height:1.05;z-index:3}.quote span{font-size:15px}.quote:after{content:"";display:block;width:56px;height:2px;background:var(--gold);margin-top:10px}.track-card{position:absolute;z-index:4;right:5%;top:82px;width:305px;padding:20px 22px;background:#101314ed;border:1px solid #3b3d3e;border-radius:16px;color:#fff;box-shadow:0 15px 45px #0008}.track-card h3{font-family:'Barlow Condensed';font-size:26px;line-height:.95;margin:0 0 11px}.track-card h3 span{color:var(--gold)}.track-card p{font-size:12px;margin:0 0 9px}.track-card input,.contact-form input,.contact-form textarea{width:100%;border:1px solid #d4d4d4;border-radius:8px;padding:12px;font:inherit;outline:none}.track-card input:focus,.contact-form input:focus,.contact-form textarea:focus{border-color:var(--gold)}.track-card .full{width:100%;margin-top:10px}.track-card small{display:block;margin-top:15px;font-size:11px;line-height:1.45;color:#eee}.track-result{display:none;margin-top:10px;padding:10px;border-radius:8px;background:#222728;font-size:12px;line-height:1.4}.track-result.show{display:block}.section{padding:34px 5.5%}.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}.section-head h2{font-family:'Barlow Condensed';font-size:30px;margin:0;letter-spacing:.5px}.section-head p{font-size:13px;margin:0;color:#222}.service-grid{display:grid;grid-template-columns:repeat(8,1fr);gap:10px}.service-card{min-height:90px;border:1px solid #ddd;border-radius:8px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;box-shadow:0 3px 10px #00000009}.service-card strong{font-size:24px;color:#a26700;margin-bottom:4px}.service-card h3{font-size:12px;margin:0}.service-card p{font-size:12px;margin:0;font-weight:700}.about{display:grid;grid-template-columns:1.2fr 1fr;gap:50px;background:#f6f6f4;border-top:1px solid #eee;border-bottom:1px solid #eee}.eyebrow.dark{color:#8a5800;letter-spacing:3px}.about h2{font-family:'Barlow Condensed';font-size:44px;line-height:1;margin:5px 0 10px}.about p{line-height:1.65;color:#555;max-width:650px}.about-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;align-items:center}.about-stats div{background:#fff;border:1px solid #ddd;border-radius:10px;padding:24px 12px;text-align:center}.about-stats b{display:block;font-family:'Barlow Condensed';font-size:32px;color:#a26700}.about-stats span{font-size:11px}.areas{background:#0c0f10;color:#fff;position:relative;overflow:hidden}.dark-head p{color:#aaa}.dark-head h2{color:#fff}.area-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:0}.area-grid ul{list-style:none;padding:0 25px;margin:0;border-right:1px solid #333}.area-grid ul:first-child{padding-left:0}.area-grid li{font-size:13px;margin:7px 0;color:#e8e8e8}.area-grid li:before{content:"●";color:var(--gold);margin-right:10px;font-size:9px}.map-note{position:absolute;right:6%;bottom:30px;color:#999;text-align:center;font-size:11px}.map-note b{color:#fff;font-size:13px}.contact-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:50px}.contact-info{border:1px solid #ddd;border-radius:12px;padding:22px;background:#fafafa}.contact-info h3{font-family:'Barlow Condensed';font-size:27px;margin:0 0 15px}.contact-info p{font-size:13px;line-height:1.45;margin:12px 0}.contact-info a{font-weight:800}.contact-form{display:grid;grid-template-columns:1fr 1fr;gap:12px}.contact-form textarea{grid-column:1/-1;resize:vertical}.contact-form button{justify-self:start}.form-note{grid-column:1/-1;font-size:12px;color:#666;margin:0}.form-note.ok{color:#257a32}footer{background:#0b0d0e;color:#ddd;padding:16px 5.5%;display:flex;justify-content:space-between;font-size:11px;border-top:2px solid var(--gold)}

@media(max-width:1100px){.header{gap:15px}.brand{width:255px}.brand img{width:245px}.nav{gap:18px}.nav a{font-size:13px}.service-grid{grid-template-columns:repeat(4,1fr)}.hero{grid-template-columns:1fr}.hero-visual{min-height:430px}.hero-copy{padding-bottom:30px}.track-card{right:4%}}
@media(max-width:760px){.topbar{font-size:9px;padding:0 15px}.topbar span:last-child{display:none}.header{height:72px;padding:0 16px}.brand{width:auto}.brand img{width:205px;height:58px}.menu-toggle{display:block;margin-left:auto}.nav{display:none;position:absolute;left:0;right:0;top:72px;background:#090b0c;flex-direction:column;gap:0;padding:10px 20px;border-top:1px solid #222}.nav.open{display:flex}.nav a{width:100%;padding:14px 0}.nav a.active:after{bottom:5px}.nav-cta{display:none}.hero-copy{padding:28px 20px 24px}.hero h1{font-size:47px}.hero h2{font-size:17px}.hero-copy>p{font-size:14px}.hero-actions{flex-direction:column}.hero-actions .btn{width:100%}.trust-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.hero-visual{min-height:480px}.track-card{left:20px;right:20px;top:95px;width:auto}.quote{right:20px}.section{padding:30px 20px}.section-head{display:block}.section-head p{margin-top:6px}.service-grid{grid-template-columns:repeat(2,1fr)}.about{grid-template-columns:1fr;gap:20px}.about h2{font-size:38px}.about-stats{grid-template-columns:1fr 1fr 1fr}.about-stats div{padding:18px 6px}.about-stats b{font-size:25px}.area-grid{grid-template-columns:1fr 1fr}.area-grid ul{padding:0 12px;margin-bottom:18px}.area-grid ul:nth-child(odd){padding-left:0}.area-grid ul:nth-child(even){border-right:0}.map-note{display:none}.contact-grid{grid-template-columns:1fr;gap:20px}.contact-form{grid-template-columns:1fr}.contact-form textarea,.contact-form button{grid-column:auto}footer{flex-direction:column;gap:7px;text-align:center}}

/* Live ERP tracking */
.live-track-result { line-height: 1.7; }
.tracking-history { margin-top: 10px; display: grid; gap: 8px; }
.tracking-history > div { padding: 8px 10px; border-left: 2px solid currentColor; background: rgba(255,255,255,.05); }

/* Phase 15: separate live tracking, dynamic stations and ERP-synced branches */
.hero-track-cta{position:absolute;right:5%;bottom:28px;z-index:5}
.tracking{background:#f6f6f4;border-top:1px solid #eee;border-bottom:1px solid #eee}
.tracking-layout{display:grid;grid-template-columns:1fr 1fr;gap:22px;align-items:stretch}
.tracking-panel,.tracking-info{background:#fff;border:1px solid #ddd;border-radius:14px;padding:24px;box-shadow:0 4px 15px #0000000a}
.tracking-panel h3,.tracking-info h3{font-family:'Barlow Condensed';font-size:28px;margin:0 0 8px}
.tracking-panel p,.tracking-info p{font-size:13px;color:#555;line-height:1.55}
.tracking-panel label,.branch-search-wrap label{display:block;font-size:12px;font-weight:800;margin:12px 0 6px}
.tracking-panel input,.branch-search-wrap input{width:100%;padding:13px;border:1px solid #ccc;border-radius:8px;font:inherit;outline:none}
.tracking-panel input:focus,.branch-search-wrap input:focus{border-color:var(--gold)}
.tracking-panel .full{width:100%;margin-top:10px}
.track-badges{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.track-badges span{border:1px solid #ddd;border-radius:999px;padding:8px 12px;font-size:11px;font-weight:800}
.station-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}
.station-chip{background:#111516;border:1px solid #343738;border-radius:8px;padding:11px 12px;color:#eee;font-size:12px}.station-chip span{color:var(--gold);margin-right:7px}
.branches{background:#fff}.branch-search-wrap{max-width:700px;margin-bottom:18px}.branch-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.branch-card{display:grid;grid-template-columns:48px 1fr;gap:12px;border:1px solid #ddd;border-radius:12px;padding:17px;background:#fafafa}.branch-icon{width:42px;height:42px;border-radius:10px;background:#111516;color:var(--gold);display:grid;place-items:center;font-size:22px}.branch-card h3{margin:0 0 8px;font-size:16px}.branch-card p{font-size:12px;color:#555;line-height:1.45;margin:5px 0}.branch-card a{font-weight:700}
@media(max-width:900px){.tracking-layout{grid-template-columns:1fr}.station-grid{grid-template-columns:repeat(3,1fr)}.branch-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){.hero-track-cta{left:20px;right:20px;bottom:22px}.hero-track-cta .btn{width:100%}.station-grid{grid-template-columns:1fr 1fr}.branch-grid{grid-template-columns:1fr}}
